      "homepage": "https://developers.gamma.app/mcp/gamma-mcp-server",
      "notice": "连接前需由 Gamma 放行 AIPP 的桌面回调地址。授权时选择工作区，生成和编辑消耗该工作区额度，导出免费。",
      "platforms": [
        "windows",
        "macos",
        "linux"
      ],
      "connection": {
        "transport": "http",
        "url": "https://mcp.gamma.app/mcp",
        "auth": "oauth",
        "oauth_resource": "https://mcp.gamma.app",
        "scopes": [
          "generate",
          "gamma:read"
        ]
      },
      "fields": [],
      "skill_ids": []
    },
