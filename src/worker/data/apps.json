{
  "schema_version": 1,
  "version": "2026-11-15.2",
  "apps": [
    {
      "id": "notion",
      "version": "1",
      "name": "Notion",
      "description": "搜索、阅读和编辑 Notion 工作空间中的页面。",
      "publisher": "Notion",
      "category": "效率",
      "icon": "notebook",
      "homepage": "https://developers.notion.com/guides/mcp/get-started-with-mcp",
      "notice": "通过浏览器授权 Notion 工作空间；访问范围、费用与配额由 Notion 决定。连接不会自动授权所有助手。",
      "platforms": [
        "windows",
        "macos",
        "linux"
      ],
      "connection": {
        "transport": "http",
        "url": "https://mcp.notion.com/mcp",
        "auth": "oauth",
        "scopes": [
          "default"
        ],
        "oauth_resource": "https://mcp.notion.com"
      },
      "fields": [],
      "skill_ids": [],
      "plugin_source": {
        "repo": "openai/plugins",
        "git_ref": "main",
        "path": "plugins/notion"
      }
    },
    {
      "id": "github",
      "version": "1",
      "name": "GitHub",
      "description": "查询代码仓库、管理 Issue 和 Pull Request。",
      "publisher": "GitHub",
      "category": "开发工具",
      "icon": "github",
      "homepage": "https://github.com/github/github-mcp-server",
      "notice": "本条目使用你主动提供的 GitHub Personal Access Token。令牌权限和组织策略决定可用资源；浏览器 OAuth 需要另行注册 AIPP 客户端，当前条目不提供。",
      "platforms": [
        "windows",
        "macos",
        "linux"
      ],
      "connection": {
        "transport": "http",
        "url": "https://api.githubcopilot.com/mcp/",
        "auth": "fields",
        "scopes": []
      },
      "fields": [
        {
          "key": "token",
          "label": "Personal Access Token",
          "kind": "password",
          "required": true,
          "secret": true,
          "help": "使用只覆盖所需仓库和操作的令牌。令牌保存在本机系统安全存储中。",
          "header": "Authorization",
          "prefix": "Bearer "
        }
      ],
      "skill_ids": [],
      "plugin_source": {
        "repo": "openai/plugins",
        "git_ref": "main",
        "path": "plugins/github"
      }
    },
    {
      "id": "runway",
      "version": "2",
      "icon": "https://aipp-helper.xiejingyang.com/agent-plugin-icons/runway.png",
      "name": "Runway",
      "description": "在对话中使用 Runway 生成图片和视频。",
      "publisher": "Runway",
      "category": "创意工具",
      "homepage": "https://mcp.runwayml.com/",
      "notice": "通过浏览器登录 Runway。生成图片或视频会消耗当前 Runway 账号的积分，重试和重新生成也会单独计费。",
      "platforms": ["windows", "macos", "linux"],
      "connection": {
        "transport": "http",
        "url": "https://mcp.runwayml.com/mcp",
        "auth": "oauth",
        "scopes": ["api:read_write"]
      },
      "fields": [],
      "skill_ids": []
    }
  ]
}
