          "kind": "password",
          "secret": true,
          "required": true,
          "header": "X-API-KEY"
        }
      ],
      "skill_ids": []
    },
    {
      "id": "gamma",
      "version": "1",
      "name": "Gamma",
      "description": "使用 Gamma 工作区额度生成图片、演示文稿、文档和网页，可导出 PDF、PPTX 或逐页 PNG。",
